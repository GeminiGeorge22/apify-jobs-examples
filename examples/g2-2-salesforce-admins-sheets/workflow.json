    {
      "id": "ebf02084-c3b6-4de0-b25a-9434b181d69c",
      "name": "Filter Salesforce admin roles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        0
      ],
      "parameters": {
        "jsCode": "const KEYWORDS = [\n  /salesforce\\s*admin/i,\n  /salesforce\\s*administrator/i,\n  /\\bsf\\s*admin\\b/i,\n  /salesforce\\s*ops/i,\n  /salesforce\\s*analyst/i,\n  /salesforce\\s*architect/i,\n  /salesforce\\s*developer/i,\n  /salesforce\\s*engineer/i,\n  /crm\\s*admin/i,\n  /revops.*salesforce/i,\n  /salesforce.*revops/i,\n  /gtm systems.*salesforce/i,\n  /salesforce/i\n];\nconst all = items.flatMap(i => Array.isArray(i.json) ? i.json.map(j=>({json:j})) : [i]);\nconst hits = [];\nconst scrapedAt = new Date().toISOString();\nfor (const it of all) {\n  const j = it.json || {};\n  const title = String(j.title || j.jobTitle || j.name || '');\n  const dept = String(j.department || j.team || '');\n  const hay = title + ' ' + dept;\n  const matched = KEYWORDS.find(re => re.test(hay));\n  if (!matched) continue;\n  hits.push({\n    json: {\n      company: j.company || j.companyName || '',\n      title,\n      department: dept,\n      location: j.location || (Array.isArray(j.locations) ? j.locations.join('; ') : '') || '',\n      jobUrl: j.url || j.jobUrl || j.source_url || j.apply_url || '',\n      postedAt: j.published_at || j.postedAt || j.updated_at || '',\n      matchedKeyword: matched.source || String(matched),\n      scrapedAt,\n      ats: j.ats || 'ashby'\n    }\n  });\n}\nif (!hits.length) {\n  return [{json: {matched: 0, note: 'No Salesforce-admin / RevOps-Salesforce titles in this batch', scanned: all.length, scrapedAt}}];\n}\nreturn hits.map(h => ({json: {...h.json, matched: 1, scanned: all.length}}));\n"
      }
    },
