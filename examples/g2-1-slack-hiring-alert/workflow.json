    {
      "id": "80c41652-3eb5-42a4-ae59-aa006d34c917",
      "name": "Filter sales / RevOps",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        0
      ],
      "parameters": {
        "jsCode": "const KEYWORDS = [/sales/i,/account executive/i,/\\bAE\\b/,/revops/i,/revenue ops/i,/business development/i,/\\bBDR\\b/,/\\bSDR\\b/,/account manager/i,/customer success/i,/\\bCSM\\b/,/go.to.market/i,/\\bGTM\\b/,/partnerships/i,/growth.*sales/i];\nconst items = items.flatMap(i => Array.isArray(i.json) ? i.json.map(j=>({json:j})) : [i]);\nconst hits = [];\nfor (const it of items) {\n  const j = it.json || {};\n  const title = String(j.title || j.jobTitle || j.name || '');\n  const dept = String(j.department || j.team || '');\n  const hay = title + ' ' + dept;\n  if (KEYWORDS.some(re => re.test(hay))) hits.push({json: j});\n}\nif (!hits.length) {\n  return [{json: {matched: 0, note: 'No sales/RevOps titles in this batch', scanned: items.length}}];\n}\nreturn hits.map(h => ({json: {...h.json, matched: 1, scanned: items.length}}));\n"
      }
    },
